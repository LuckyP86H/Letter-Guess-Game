{
  "name": "letter-guess-game",
  "version": "2.0.0",
  "private": true,
  "description": "A letter-guessing game: solo, daily, and friends rooms, with GitHub and Google sign-in",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "test": "bun test src",
    "e2e": "playwright test",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "hono": "^4.13.14",
    "solid-js": "^1.9.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.155.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
